  "typography": {
    "display": {
      "family": "Space Grotesk",
      "weights": [500, 700],
      "use": "Títulos h1-h6, números grandes, CTAs",
      "fallback_continuity": "Work Sans Black"
    },
    "body": {
      "family": "Inter",
      "weights": [400, 500, 600],
      "use": "Parágrafos, UI, tabelas explicativas"
    },
    "mono": {
      "family": "JetBrains Mono",
      "weights": [400, 500],
      "use": "Dados numéricos, tickers, código, listings"
    },
    "print_xetex": {
      "display": "Space Grotesk",
      "body": "Inter",
      "mono": "JetBrains Mono"
    },
    "print_pdftex_fallback": {
      "sans": "Fira Sans",
      "mono": "Fira Mono"
    }
  },
  "elevation": {
    "card": "0 1px 0 0 rgba(255,255,255,.02) inset, 0 8px 24px -16px rgba(0,0,0,.6)",
    "glow_volt": "0 0 0 1px rgba(31,224,122,.18), 0 10px 34px -14px rgba(31,224,122,.28)",
    "focus_ring": "0 0 0 3px rgba(31,224,122,.35)"
  },
  "radius": {
    "sm": "8px",
    "md": "10px",
    "lg": "12px",
    "xl": "16px",
    "pill": "999px"
  }
