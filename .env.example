# Syntaxis Skill Check — variáveis de ambiente
# Copie este arquivo para .env.local e preencha os valores reais.
# NUNCA commitar .env.local (já está no .gitignore).

# MailerLite — usada no Épico 7 (captura de lead), somente em código server-side
# (Route Handlers). Nunca deve ser exposta ao client nem prefixada com NEXT_PUBLIC_.
# Gerada em: painel MailerLite → Integrations → MailerLite API.
MAILERLITE_API_KEY=

# ID do Grupo MailerLite para onde todos os leads do quiz vão (conta real:
# grupo "SYNTAXIS_SKILL_APP"). A classificação/senioridade/score ficam nos
# Campos customizados do subscriber, não em grupos separados por faixa.
MAILERLITE_GROUP_ID=

# GA4 e Meta Pixel (Épico 21) — expostas ao client (NEXT_PUBLIC_) de
# propósito: são identificadores públicos, não segredos, e precisam existir
# no bundle do browser para os SDKs de analytics funcionarem. Nunca
# carregam sem consentimento explícito do visitante (LGPD — ver
# components/analytics/AnalyticsProvider.tsx e ConsentBanner.tsx). Deixe em
# branco em ambientes de teste/preview para não sujar os dados de produção;
# os valores reais entram só nas variáveis de ambiente da Vercel.
# Measurement ID real da conta: G-H0NTV61JS6 (fluxo "Syntaxis Educacao").
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# Pixel ID real da conta: 852035937455815 (conjunto de dados 2151084515475904).
NEXT_PUBLIC_META_PIXEL_ID=
