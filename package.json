{
  "name": "syntaxis-skill-check",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "generate:tokens": "node scripts/generate-tokens-css.mjs",
    "check:tokens-breaking": "node scripts/check-tokens-breaking.mjs",
    "validate:questions": "node scripts/validate-questions.mjs",
    "item-stats": "node scripts/item-stats.mjs",
    "lint:colors": "node scripts/lint-hardcoded-colors.mjs",
    "audit:contrast": "node scripts/audit-contrast.mjs",
    "lint:patterns": "node scripts/lint-one-pattern-per-file.mjs",
    "lint:radius": "node scripts/lint-radius.mjs",
    "assets:process": "node scripts/process-asset.mjs",
    "assets:verify-manifest": "node scripts/verify-manifest.mjs",
    "assets:verify-palette": "node scripts/verify-asset-palette.mjs",
    "predev": "npm run generate:tokens",
    "prebuild": "npm run generate:tokens && npm run check:tokens-breaking && npm run validate:questions && npm run lint:colors && npm run audit:contrast && npm run lint:patterns && npm run lint:radius && npm run assets:verify-manifest && npm run assets:verify-palette",
    "dev": "next dev --turbopack",
    "build": "next build --turbopack",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:update-snapshots": "playwright test --update-snapshots",
    "test:e2e:remote": "PLAYWRIGHT_BASE_URL=$URL playwright test",
    "lighthouse": "node scripts/lighthouse-check.mjs http://localhost:3000/",
    "test:lighthouse": "start-server-and-test start http://localhost:3000 lighthouse",
    "lighthouse:flow": "node scripts/lighthouse-flow-check.mjs http://localhost:3000 light && node scripts/lighthouse-flow-check.mjs http://localhost:3000 dark",
    "test:lighthouse:flow": "start-server-and-test start http://localhost:3000 lighthouse:flow"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@mailerlite/mailerlite-nodejs": "^1.7.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.30.0",
    "next": "15.5.23",
    "next-themes": "^0.4.6",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@eslint/eslintrc": "^3",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.5",
    "chrome-launcher": "^1.2.1",
    "eslint": "^9",
    "eslint-config-next": "15.5.23",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^30.0.1",
    "lighthouse": "^13.4.1",
    "prettier": "^3.9.6",
    "puppeteer-core": "^25.5.0",
    "shadcn": "^4.16.2",
    "sharp": "^0.35.3",
    "start-server-and-test": "^3.0.12",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.10",
    "yaml": "^2.9.0"
  }
}
